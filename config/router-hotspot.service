[Unit]
Description=LTE router Wi-Fi hotspot
After=systemd-networkd.service router-firewall.service
Requires=router-firewall.service

[Service]
Type=simple
ExecStartPre=/usr/sbin/rfkill unblock wlan
ExecStartPre=/usr/sbin/ip link set wlan0 up
ExecStartPre=/usr/sbin/ip address replace 192.168.20.1/24 dev wlan0
ExecStart=/usr/sbin/hostapd /usr/local/lib/router/hostapd.conf
ExecStopPost=/usr/sbin/ip link set wlan0 down
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
