[Unit]
Description=STM32 router LAN settings page
After=systemd-networkd.service router-firewall.service dnsmasq.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/router-web/server.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/usr/local/lib/router /var/lib/router-web
RestrictAddressFamilies=AF_INET AF_UNIX AF_NETLINK

[Install]
WantedBy=multi-user.target
