#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1

start_service() {
    [ -f /etc/router-web/configured ] || return 0
    /usr/bin/python3 /usr/lib/router-web/initialize.py || return 1
    procd_open_instance
    procd_set_param command /usr/bin/python3 /usr/lib/router-web/server.py
    procd_set_param env PYTHONDONTWRITEBYTECODE=1
    # Retry if the LAN address is not ready yet at boot.
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
