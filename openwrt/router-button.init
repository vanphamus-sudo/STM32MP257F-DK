#!/bin/sh /etc/rc.common
# Start before networking so interrupted recovery writes are restored first.
START=18
STOP=10
USE_PROCD=1
start_service() {
    /usr/bin/python3 -c 'import sys; sys.path.insert(0,"/usr/lib/router-web"); import recovery_button as b, openwrt_backend as p; from server import atomic_write; b.restore_pending(p, atomic_write)' || return 1
    procd_open_instance
    procd_set_param command /usr/bin/python3 /usr/lib/router-web/recovery_button.py
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
