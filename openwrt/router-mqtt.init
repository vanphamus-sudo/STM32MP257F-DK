#!/bin/sh /etc/rc.common
START=98
STOP=7
USE_PROCD=1
start_service() {
    [ -f /etc/router-web/mqtt.json ] || return 0
    /usr/bin/python3 -c 'import json,sys; sys.exit(not json.load(open("/etc/router-web/mqtt.json")).get("enabled",False))' || return 0
    procd_open_instance
    procd_set_param command /usr/bin/python3 /usr/lib/router-web/mqtt_client.py
    procd_set_param env PYTHONDONTWRITEBYTECODE=1
    procd_set_param file /etc/router-web/mqtt.json
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
