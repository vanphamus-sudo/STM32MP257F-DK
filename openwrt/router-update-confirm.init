#!/bin/sh /etc/rc.common
START=99
USE_PROCD=1
start_service() {
    [ -f /etc/router-web/system-slots.json ] || return 0
    procd_open_instance
    procd_set_param command /usr/bin/python3 /usr/lib/router-web/system_update.py --confirm-boot
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
