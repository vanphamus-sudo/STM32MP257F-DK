#!/bin/sh /etc/rc.common
START=19
STOP=8
USE_PROCD=1
start_service() {
    /usr/sbin/router-modem-bind
    procd_open_instance
    procd_set_param command /usr/bin/python3 /usr/lib/router-web/modem_auto.py
    procd_set_param env PYTHONDONTWRITEBYTECODE=1
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
