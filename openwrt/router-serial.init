#!/bin/sh /etc/rc.common
START=96
STOP=9
USE_PROCD=1
start_service() {
    [ -f /etc/router-web/serial-tcp.json ] || return 0
    /usr/bin/python3 /usr/lib/router-web/serial_tcp.py --check-enabled || return 0
    procd_open_instance
    procd_set_param command /usr/bin/python3 /usr/lib/router-web/serial_tcp.py
    procd_set_param env PYTHONDONTWRITEBYTECODE=1
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param file /etc/router-web/serial-tcp.json
    procd_close_instance
}
