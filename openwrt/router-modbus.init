#!/bin/sh /etc/rc.common
START=98
STOP=7
USE_PROCD=1
start_service() {
    [ -f /etc/router-web/modbus.json ] || return 0
    /usr/bin/python3 /usr/lib/router-web/modbus_collection.py --check-enabled || return 0
    procd_open_instance
    procd_set_param command /usr/bin/python3 /usr/lib/router-web/modbus_collection.py
    procd_set_param env PYTHONDONTWRITEBYTECODE=1
    procd_set_param file /etc/router-web/modbus.json
    procd_set_param respawn 3600 5 0
    procd_set_param term_timeout 40
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
